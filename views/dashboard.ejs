<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Recharge Dashboard' %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-base: #0f172a;
            --bg-surface: #1e293b;
            --bg-surface-hover: #334155;
            --border-color: #334155;
            
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;
            
            --brand-primary: #6366f1;
            --brand-primary-hover: #4f46e5;
            --brand-success: #10b981;
            --brand-success-hover: #059669;
            --brand-warning: #f59e0b;
            --brand-danger: #ef4444;
            --brand-danger-hover: #dc2626;
            --brand-info: #06b6d4;
            --brand-purple: #8b5cf6;
            
            --radius-sm: 6px;
            --radius-md: 10px;
            --radius-lg: 16px;
            --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
            --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
            --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.25), 0 4px 6px -4px rgb(0 0 0 / 0.1);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background-color: var(--bg-base);
            color: var(--text-primary);
            line-height: 1.5;
            min-height: 100vh;
            padding-bottom: 40px;
        }

        /* App Container */
        .app-layout {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 24px;
        }

        /* Header */
        .dashboard-header {
            background-color: var(--bg-surface);
            border-bottom: 1px solid var(--border-color);
            padding: 16px 24px;
            margin-bottom: 32px;
            position: sticky;
            top: 0;
            z-index: 40;
            backdrop-filter: blur(8px);
        }

        .header-content {
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header-left h1 {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-primary);
            letter-spacing: -0.025em;
        }

        .header-icon {
            font-size: 1.25rem;
            color: var(--brand-warning);
            background: rgba(245, 158, 11, 0.15);
            padding: 10px;
            border-radius: var(--radius-md);
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-badge {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-color);
            padding: 6px 14px;
            border-radius: 9999px;
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--text-secondary);
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 8px 16px;
            border-radius: var(--radius-md);
            font-size: 0.875rem;
            font-weight: 600;
            cursor: pointer;
            border: 1px solid transparent;
            transition: all 0.2s ease;
            text-decoration: none;
            white-space: nowrap;
        }

        .btn-sm {
            padding: 6px 12px;
            font-size: 0.8125rem;
        }

        .btn-primary { background-color: var(--brand-primary); color: white; }
        .btn-primary:hover { background-color: var(--brand-primary-hover); }

        .btn-secondary { background-color: transparent; border-color: var(--border-color); color: var(--text-secondary); }
        .btn-secondary:hover { background-color: var(--bg-surface-hover); color: var(--text-primary); }

        .btn-success { background-color: var(--brand-success); color: white; }
        .btn-success:hover { background-color: var(--brand-success-hover); }

        .btn-danger { background-color: var(--brand-danger); color: white; }
        .btn-danger:hover { background-color: var(--brand-danger-hover); }

        .btn-purple { background-color: var(--brand-purple); color: white; }
        .btn-purple:hover { opacity: 0.9; }

        .btn-info { background-color: var(--brand-info); color: white; }
        .btn-info:hover { opacity: 0.9; }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-bottom: 32px;
        }

        .stat-card {
            background-color: var(--bg-surface);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 20px;
            display: flex;
            align-items: flex-start;
            gap: 16px;
            box-shadow: var(--shadow-sm);
            transition: transform 0.2s ease;
        }

        .stat-card:hover {
            transform: translateY(-2px);
        }

        .stat-card.wide {
            grid-column: span 2;
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            flex-shrink: 0;
        }

        .stat-icon.blue { background: rgba(99, 102, 241, 0.15); color: var(--brand-primary); }
        .stat-icon.green { background: rgba(16, 185, 129, 0.15); color: var(--brand-success); }
        .stat-icon.purple { background: rgba(139, 92, 246, 0.15); color: var(--brand-purple); }
        .stat-icon.orange { background: rgba(245, 158, 11, 0.15); color: var(--brand-warning); }
        .stat-icon.pink { background: rgba(236, 72, 153, 0.15); color: #ec4899; }

        .stat-info h3 {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-primary);
            line-height: 1.2;
        }

        .stat-info p {
            font-size: 0.875rem;
            color: var(--text-secondary);
            margin-top: 2px;
        }

        .stat-meta {
            margin-top: 8px;
            padding-top: 8px;
            border-top: 1px solid var(--border-color);
            font-size: 0.75rem;
            color: var(--text-muted);
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

        /* Controls Section */
        .controls-container {
            background-color: var(--bg-surface);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 20px;
            margin-bottom: 24px;
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            justify-content: space-between;
            align-items: center;
        }

        .filter-group {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
            flex: 1;
            min-width: 300px;
        }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-wrapper i {
            position: absolute;
            left: 12px;
            color: var(--text-muted);
            font-size: 0.875rem;
        }

        .input-control {
            background-color: var(--bg-base);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            padding: 8px 12px 8px 36px;
            border-radius: var(--radius-md);
            font-size: 0.875rem;
            outline: none;
            transition: border-color 0.2s ease;
        }

        .input-control:focus {
            border-color: var(--brand-primary);
        }

        .input-control[type="date"] {
            padding-left: 36px;
            color-scheme: dark;
        }

        .actions-group {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px;
        }

        .record-count {
            font-size: 0.875rem;
            color: var(--text-muted);
            font-weight: 500;
            margin-left: 8px;
        }

        /* Data Table */
        .table-container {
            background-color: var(--bg-surface);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
        }

        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 0.875rem;
        }

        th {
            background-color: rgba(0, 0, 0, 0.2);
            color: var(--text-secondary);
            font-weight: 600;
            padding: 14px 16px;
            border-bottom: 1px solid var(--border-color);
            white-space: nowrap;
        }

        td {
            padding: 14px 16px;
            border-bottom: 1px solid var(--border-color);
            color: var(--text-primary);
            white-space: nowrap;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.02);
        }

        .loading-row {
            text-align: center;
            padding: 40px;
            color: var(--text-muted);
        }

        /* Pagination */
        .pagination-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 24px;
            background-color: var(--bg-surface);
            border: 1px solid var(--border-color);
            border-top: none;
            border-bottom-left-radius: var(--radius-lg);
            border-bottom-right-radius: var(--radius-lg);
            margin-top: -1px;
        }

        .pagination-controls {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        #pageInfo {
            font-size: 0.875rem;
            color: var(--text-secondary);
            font-weight: 500;
        }

        .page-size-control {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.875rem;
            color: var(--text-secondary);
        }

        .page-size-control select {
            background-color: var(--bg-base);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            padding: 4px 8px;
            border-radius: var(--radius-sm);
            outline: none;
        }

        /* Modals */
        .modal {
            display: none;
            position: fixed;
            inset: 0;
            background-color: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(4px);
            z-index: 50;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .modal-content {
            background-color: var(--bg-surface);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            width: 100%;
            max-width: 540px;
            box-shadow: var(--shadow-lg);
            overflow: hidden;
            animation: modalFadeIn 0.2s ease-out;
        }

        @keyframes modalFadeIn {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
        }

        .modal-header {
            padding: 20px 24px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-header h2 {
            font-size: 1.125rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .close {
            color: var(--text-muted);
            font-size: 1.5rem;
            cursor: pointer;
            line-height: 1;
        }

        .close:hover { color: var(--text-primary); }

        .modal-body, form {
            padding: 24px;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .form-group label {
            font-size: 0.8125rem;
            font-weight: 600;
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .form-group input {
            background-color: var(--bg-base);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            padding: 10px 12px;
            border-radius: var(--radius-md);
            font-size: 0.875rem;
            outline: none;
            color-scheme: dark;
        }

        .form-group input:focus {
            border-color: var(--brand-primary);
        }

        .modal-actions {
            padding: 16px 24px;
            background-color: rgba(0, 0, 0, 0.2);
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: flex-end;
            gap: 12px;
        }

        /* Toast Notifications */
        .toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background-color: var(--bg-surface);
            border: 1px solid var(--brand-success);
            padding: 12px 20px;
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-lg);
            display: none;
            z-index: 60;
        }

        .toast-content {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--text-primary);
            font-size: 0.875rem;
            font-weight: 500;
        }

        .toast-icon { color: var(--brand-success); }

        @media (max-width: 900px) {
            .stat-card.wide { grid-column: span 1; }
            .form-row { grid-template-columns: 1fr; }
            .controls-container { flex-direction: column; align-items: stretch; }
            .filter-group, .actions-group { width: 100%; justify-content: space-between; }
        }
    </style>
</head>
<body>

    <!-- Top Header -->
    <header class="dashboard-header">
        <div class="header-content">
            <div class="header-left">
                <i class="fas fa-coins header-icon"></i>
                <h1>Recharge Records</h1>
            </div>
            <div class="header-right">
                <span class="user-badge">
                    <i class="fas fa-user"></i>
                    <%= user || 'Admin' %>
                </span>
                <a href="https://botadmin-2r2n.onrender.com/login" class="btn btn-purple btn-sm">
                    Details
                </a>
                <a href="/withdraw" class="btn btn-purple btn-sm">
                    Withdraw
                </a>
                <a href="/logout" class="btn btn-danger btn-sm">
                    <i class="fas fa-sign-out-alt"></i>
                    Logout
                </a>
            </div>
        </div>
    </header>

    <main class="app-layout">
        <!-- Overview Dashboard Cards -->
        <section class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon blue">
                    <i class="fas fa-file-alt"></i>
                </div>
                <div class="stat-info">
                    <h3 id="totalRecords">0</h3>
                    <p>Total Records</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon green">
                    <i class="fas fa-dollar-sign"></i>
                </div>
                <div class="stat-info">
                    <h3 id="totalAmount">$0</h3>
                    <p>Total Amount</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon purple">
                    <i class="fas fa-users"></i>
                </div>
                <div class="stat-info">
                    <h3 id="uniqueUsers">0</h3>
                    <p>Unique Users</p>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon orange">
                    <i class="fas fa-clock"></i>
                </div>
                <div class="stat-info">
                    <h3 id="todayRecords">0</h3>
                    <p>Today's Records</p>
                </div>
            </div>

            <!-- Database Storage Analytics -->
            <div class="stat-card wide">
                <div class="stat-icon pink">
                    <i class="fas fa-database"></i>
                </div>
                <div class="stat-info" style="width: 100%;">
                    <h3 id="storageUsage">
                        <%
                            let rechargeSize = 0, withdrawSize = 0;
                            let rechargeCount = 0, withdrawCount = 0;
                            
                            try {
                                if (typeof storage !== 'undefined' && storage) {
                                    if (storage.recharges) {
                                        rechargeSize = parseFloat(storage.recharges.size) || 0;
                                        rechargeCount = parseInt(storage.recharges.count) || 0;
                                    }
                                    if (storage.withdraws) {
                                        withdrawSize = parseFloat(storage.withdraws.size) || 0;
                                        withdrawCount = parseInt(storage.withdraws.count) || 0;
                                    }
                                }
                            } catch(e) {
                                console.error('Error parsing storage data:', e);
                            }
                            
                            const totalStorageMB = rechargeSize + withdrawSize;
                            const totalRecords = rechargeCount + withdrawCount;
                            const avgRecordSizeKB = totalRecords > 0 ? (totalStorageMB * 1024) / totalRecords : 0;
                        %>
                        <%= totalStorageMB.toFixed(2) %> MB
                    </h3>
                    <p>Database Storage Used</p>
                    <div class="stat-meta">
                        <span><strong id="recordCountStorage"><%= totalRecords %></strong> records</span>
                        <span>•</span>
                        <span><strong id="avgRecordSize"><%= avgRecordSizeKB.toFixed(2) %></strong> KB/rec</span>
                        <span>•</span>
                        <span>Recharges: <%= rechargeSize.toFixed(2) %>MB (<%= rechargeCount %>)</span>
                        <span>•</span>
                        <span>Withdraws: <%= withdrawSize.toFixed(2) %>MB (<%= withdrawCount %>)</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Search and Actions Bar -->
        <section class="controls-container">
            <div class="filter-group">
                <div class="input-wrapper">
                    <i class="fas fa-search"></i>
                    <input type="text" id="searchInput" class="input-control" placeholder="Search user or ID..." />
                </div>
                <button onclick="searchRecords()" class="btn btn-primary">
                    Search
                </button>
                
                <div class="input-wrapper">
                    <i class="fas fa-calendar-alt"></i>
                    <input type="date" id="startDate" class="input-control" title="Start Date" />
                </div>
                <span style="color: var(--text-muted)">to</span>
                <div class="input-wrapper">
                    <i class="fas fa-calendar-alt"></i>
                    <input type="date" id="endDate" class="input-control" title="End Date" />
                </div>
                <button onclick="applyDateFilter()" class="btn btn-secondary btn-sm">
                    <i class="fas fa-filter"></i> Filter
                </button>
                <button onclick="clearDateFilter()" class="btn btn-secondary btn-sm">
                    Clear
                </button>
            </div>

            <div class="actions-group">
                <button onclick="openAddModal()" class="btn btn-success">
                    <i class="fas fa-plus"></i> Add
                </button>
                <button onclick="exportRecords()" class="btn btn-info">
                    <i class="fas fa-download"></i> Export
                </button>
                <button onclick="openDeleteAllModal()" class="btn btn-danger">
                    <i class="fas fa-trash-alt"></i> Clear All
                </button>
                <span id="recordCount" class="record-count">Showing: 0</span>
            </div>
        </section>

        <!-- Main Data Table Container -->
        <section class="table-container">
            <div class="table-wrapper">
                <table id="recordsTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Username</th>
                            <th>User ID</th>
                            <th>Amount</th>
                            <th>Fee</th>
                            <th>Request Time</th>
                            <th>Process Time</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <tr>
                            <td colspan="8" class="loading-row">
                                <i class="fas fa-spinner fa-spin"></i> Loading records...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Table Footer / Pagination -->
            <div class="pagination-container">
                <div class="pagination-controls">
                    <button onclick="changePage('prev')" id="prevBtn" class="btn btn-secondary btn-sm">
                        <i class="fas fa-chevron-left"></i> Prev
                    </button>
                    <span id="pageInfo">Page 1 of 1</span>
                    <button onclick="changePage('next')" id="nextBtn" class="btn btn-secondary btn-sm">
                        Next <i class="fas fa-chevron-right"></i>
                    </button>
                </div>
                <div class="page-size-control">
                    <label for="pageSize">Per page:</label>
                    <select id="pageSize" onchange="changePageSize()">
                        <option value="10">10</option>
                        <option value="20" selected>20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
            </div>
        </section>
    </main>

    <!-- Modal: Add / Edit Record -->
    <div id="recordModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="modalTitle"><i class="fas fa-plus-circle"></i> Add Record</h2>
                <span class="close" onclick="closeModal()">&times;</span>
            </div>
            <form id="recordForm" onsubmit="saveRecord(event)">
                <input type="hidden" id="recordId" value="">
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="formUsername"><i class="fas fa-user"></i> Username</label>
                        <input type="text" id="formUsername" placeholder="Username" required>
                    </div>
                    <div class="form-group">
                        <label for="formUserId"><i class="fas fa-id-card"></i> User ID</label>
                        <input type="text" id="formUserId" placeholder="User ID" required>
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="formAmount"><i class="fas fa-dollar-sign"></i> Amount</label>
                        <input type="number" id="formAmount" placeholder="0.00" step="0.01" required>
                    </div>
                    <div class="form-group">
                        <label for="formFee"><i class="fas fa-percent"></i> Fee</label>
                        <input type="text" id="formFee" placeholder="0.00(0%)" value="0.00(0%)" required>
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="formRequestTime"><i class="fas fa-clock"></i> Request Time</label>
                        <input type="datetime-local" id="formRequestTime" required>
                    </div>
                    <div class="form-group">
                        <label for="formProcessTime"><i class="fas fa-check-circle"></i> Process Time</label>
                        <input type="datetime-local" id="formProcessTime" required>
                    </div>
                </div>
                
                <div class="modal-actions">
                    <button type="button" onclick="closeModal()" class="btn btn-secondary">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> <span id="submitBtnText">Save</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal: Delete Single -->
    <div id="deleteModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2><i class="fas fa-exclamation-triangle" style="color: var(--brand-danger);"></i> Confirm Delete</h2>
                <span class="close" onclick="closeDeleteModal()">&times;</span>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to remove this record?</p>
                <p style="color: var(--brand-danger); font-size: 0.8125rem; margin-top: 4px;">This operation cannot be reversed.</p>
                <input type="hidden" id="deleteId" value="">
            </div>
            <div class="modal-actions">
                <button onclick="closeDeleteModal()" class="btn btn-secondary">Cancel</button>
                <button onclick="confirmDelete()" class="btn btn-danger">Delete</button>
            </div>
        </div>
    </div>

    <!-- Modal: Clear All Records -->
    <div id="deleteAllModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2><i class="fas fa-exclamation-triangle" style="color: var(--brand-danger);"></i> Purge Database</h2>
                <span class="close" onclick="closeDeleteAllModal()">&times;</span>
            </div>
            <div class="modal-body">
                <p style="margin-bottom: 12px;">This action will permanently delete <strong>ALL</strong> stored records from the database.</p>
                
                <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid var(--brand-danger); padding: 12px; border-radius: var(--radius-md); margin-bottom: 16px;">
                    <p id="deleteAllCount" style="margin: 0; font-size: 0.875rem;">
                        Total records queued for deletion: <strong id="deleteAllTotal">0</strong>
                    </p>
                </div>

                <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 0.875rem;">
                    <input type="checkbox" id="deleteAllConfirm" style="accent-color: var(--brand-danger); width: 16px; height: 16px;">
                    <span>I understand this action is permanent</span>
                </label>
            </div>
            <div class="modal-actions">
                <button onclick="closeDeleteAllModal()" class="btn btn-secondary">Cancel</button>
                <button onclick="confirmDeleteAll()" id="deleteAllBtn" class="btn btn-danger" disabled>Purge All</button>
            </div>
        </div>
    </div>

    <!-- Toast Component -->
    <div id="toast" class="toast">
        <div class="toast-content">
            <i class="fas fa-check-circle toast-icon"></i>
            <span id="toastMessage">Action completed successfully</span>
        </div>
    </div>

    <script src="/js/dashboard.js"></script>
</body>
</html>
